#: deliveries/templates/deliveries/api_docs.html:8
#: deliveries/templates/deliveries/deleted_list.html:8
#: deliveries/templates/deliveries/delivery_confirm_eta.html:8
#: deliveries/templates/deliveries/delivery_edit.html:8
#: deliveries/templates/deliveries/delivery_form.html:8
#: deliveries/templates/deliveries/delivery_list.html:3
#: deliveries/templates/deliveries/shop_profile.html:8
msgid "Deliveries"
msgstr "Dostave"

#: deliveries/templates/deliveries/api_docs.html:14
msgid ""
"Create an API key and send orders directly from your system — Javi notifies "
"your customers about the delivery."
msgstr ""
"Napravite API ključ i šaljite porudžbine direktno iz svog sistema — Javi "
"obaveštava vaše kupce o dostavi."

#: deliveries/templates/deliveries/api_docs.html:17
msgid "Generate an API key in your profile"
msgstr "Generišite API ključ u svom profilu"

#: deliveries/templates/deliveries/api_docs.html:18
msgid "Create an order (customer address + phone)"
msgstr "Napravite porudžbinu (adresa kupca + telefon)"

#: deliveries/templates/deliveries/api_docs.html:19
msgid ""
"Mark “delivery started” → customer gets a notification and a tracking link"
msgstr ""
"Označite „Dostava je počela“ → kupac dobija obaveštenje i link za praćenje"

#: deliveries/templates/deliveries/api_docs.html:20
msgid "Delivery status and rating"
msgstr "Status dostave i ocena"

#: deliveries/templates/deliveries/api_docs.html:22
msgid "Open full API documentation (Swagger UI)"
msgstr "Otvori kompletnu API dokumentaciju (Swagger UI)"

#: deliveries/templates/deliveries/api_docs.html:23
msgid "ReDoc"
msgstr "ReDoc"

#: deliveries/templates/deliveries/api_docs.html:24
msgid "OpenAPI schema"
msgstr "OpenAPI šema"

#: deliveries/templates/deliveries/api_docs.html:27
msgid "Quick start (curl)"
msgstr "Brzi početak (curl)"

#: deliveries/templates/deliveries/api_docs.html:30
msgid ""
"Authenticate with your key, create a delivery, then start it. Replace "
"javi_live_… with your key."
msgstr ""
"Prijavite se svojim ključem, kreirajte dostavu, pa je započnite. Zamenite "
"javi_live_… svojim ključem."

#: deliveries/templates/deliveries/api_docs.html:40
msgid "Start the delivery (notifies the customer)"
msgstr "Započni dostavu (obaveštava kupca)"

#: deliveries/templates/deliveries/api_docs.html:45
msgid ""
"Statuses are industry-standard: pending, ready_for_pickup, out_for_delivery, "
"delivered. The internal Javi code is also returned as status_internal."
msgstr ""
"Statusi su standardni: pending, ready_for_pickup, out_for_delivery, "
"delivered. Interni Javi kod se vraća i kao status_internal."

#: deliveries/templates/deliveries/api_key_created.html:3
#: deliveries/templates/deliveries/api_key_created.html:10
msgid "API key created"
msgstr "API ključ je kreiran"

#: deliveries/templates/deliveries/api_key_created.html:12
msgid "Copy it now — it will not be shown again."
msgstr "Kopirajte ga sada — više se neće prikazati."

#: deliveries/templates/deliveries/api_key_created.html:14
#: deliveries/templates/deliveries/shop_profile.html:119
msgid "Key"
msgstr "Ključ"

#: deliveries/templates/deliveries/api_key_created.html:17
msgid "Back to the store"
msgstr "Nazad na prodavnicu"

#: deliveries/templates/deliveries/deleted_list.html:3
msgid "Deleted"
msgstr "Obrisano"

#: deliveries/templates/deliveries/deleted_list.html:26
msgid "Restore"
msgstr "Vrati"

#: deliveries/templates/deliveries/deleted_list.html:31
msgid "No deleted orders."
msgstr "Nema obrisanih porudžbina."

#: deliveries/templates/deliveries/delivery_board.html:29
#: deliveries/templates/deliveries/delivery_form.html:3
#: deliveries/templates/deliveries/delivery_form.html:11
#: deliveries/templates/deliveries/delivery_list.html:38
msgid "New delivery"
msgstr "Nova dostava"

#: deliveries/templates/deliveries/delivery_confirm_eta.html:3
#: deliveries/templates/deliveries/delivery_confirm_eta.html:11
msgid "Confirm delivery"
msgstr "Potvrdite dostavu"

#: deliveries/templates/deliveries/delivery_confirm_eta.html:18
msgid "Estimated arrival time"
msgstr "Procenjeno vreme dolaska"

#: deliveries/templates/deliveries/delivery_confirm_eta.html:45
