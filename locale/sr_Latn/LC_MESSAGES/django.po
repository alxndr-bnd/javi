#: accounts/forms.py:18 deliveries/forms.py:23
#: templates/accounts/register.html:19
msgid "Store name"
msgstr "Naziv prodavnice"

#: accounts/forms.py:25
msgid "Store address (optional)"
msgstr "Adresa prodavnice (opciono)"

#: accounts/forms.py:52
msgid "An account with this email already exists."
msgstr "Nalog sa ovom email adresom već postoji."

#: accounts/forms.py:61
#, python-format
msgid "Too many failed sign-in attempts. Try again in %(minutes)d minutes."
msgstr ""
"Previše neuspešnih pokušaja prijave. Pokušajte ponovo za %(minutes)d minuta."

#: accounts/views.py:47
msgid "Too many new accounts from your network today. Try again tomorrow."
msgstr ""
"Danas je sa vaše mreže otvoreno previše naloga. Pokušajte ponovo sutra."

#: accounts/views.py:74
msgid "We could not recognize the store address. Check it in “Store”."
msgstr "Nismo prepoznali adresu prodavnice. Proverite je u delu „Prodavnica“."

#: common/text.py:85
msgid ""
"Store name can't contain links, email addresses, phone numbers or quotation "
"marks."
msgstr ""
"Naziv prodavnice ne može da sadrži linkove, email adrese, brojeve telefona ni"
" navodnike."

#: common/validators.py:14
msgid "The webhook URL must start with https://."
msgstr "URL vebhuka mora da počinje sa https://."

#: deliveries/api.py:91
msgid "Request body must be a JSON object."
msgstr "Telo zahteva mora biti JSON objekat."

#: deliveries/api.py:128 deliveries/api.py:182
msgid "Recipient full name."
msgstr "Ime i prezime primaoca."

#: deliveries/api.py:129
msgid "Recipient phone in E.164 (e.g. +381641234567)."
msgstr "Telefon primaoca u formatu E.164 (npr. +381641234567)."

#: deliveries/api.py:134
msgid "Delivery channel: telegram, viber, whatsapp or sms."
msgstr "Kanal slanja: telegram, viber, whatsapp ili sms."

#: deliveries/api.py:138
msgid "Receipt status: queued/sent/delivered/read/failed."
msgstr "Status isporuke poruke: queued/sent/delivered/read/failed."

#: deliveries/api.py:152
msgid ""
"Industry-standard status: pending (new), ready_for_pickup (ready), "
"out_for_delivery (in delivery), delivered."
msgstr ""
"Standardni status: pending (nova), ready_for_pickup (spremna), "
"out_for_delivery (u dostavi), delivered (isporučena)."

#: deliveries/api.py:157
msgid "Internal Javi status code: new / created / on_the_way / delivered."
msgstr "Interni Javi kod statusa: new / created / on_the_way / delivered."

#: deliveries/api.py:160
msgid "Public tracking page (set once delivery starts)."
msgstr "Javna stranica za praćenje (postoji kada dostava počne)."

#: deliveries/api.py:165
msgid "Language of the customer's messages and tracking page."
msgstr "Jezik poruka kupcu i stranice za praćenje."

#: deliveries/api.py:171
msgid "Estimated arrival, local HH:MM (set on start)."
msgstr ""
"Procenjeno vreme dolaska, lokalno HH:MM (postavlja se na početku dostave)."

#: deliveries/api.py:174
msgid "Latest 'on the way' notification receipt, if any."
msgstr "Poslednji izveštaj o isporuci poruke „u dostavi“, ako postoji."

#: deliveries/api.py:176
msgid "manual | api."
msgstr "manual | api."

#: deliveries/api.py:177
msgid "True if soft-deleted (restorable)."
msgstr "True ako je dostava obrisana (može da se vrati)."

#: deliveries/api.py:184
msgid "Recipient phone (any common Serbian format, normalized to E.164)."
msgstr ""
"Telefon primaoca (bilo koji uobičajeni srpski format, svodi se na E.164)."

#: deliveries/api.py:186
msgid "Delivery address (geocoded server-side)."
msgstr "Adresa dostave (geokodira se na serveru)."

#: deliveries/api.py:188
msgid "Optional order description."
msgstr "Opcioni opis porudžbine."

#: deliveries/api.py:195
msgid ""
"Language of the customer's messages and tracking page: `sr` (Serbian, Latin "
"script; the default) or `en`."
msgstr ""
"Jezik poruka kupcu i stranice za praćenje: `sr` (srpski, latinica; "
"podrazumevano) ili `en`."

#: deliveries/api.py:206
msgid ""
"Optional manual ETA (used when no route is available): HH:MM today, or an ISO"
" 8601 datetime such as 2026-10-03T16:30 (Belgrade time if no offset). Must be"
" in the future."
msgstr ""
"Opciono ručno vreme dolaska (kada ruta nije dostupna): HH:MM za danas ili ISO"
" 8601 datum i vreme, npr. 2026-10-03T16:30 (beogradsko vreme ako nema "
"pomaka). Mora biti u budućnosti."

#: deliveries/api.py:217
msgid "Optional new recipient phone to correct and resend."
msgstr "Opcioni novi telefon primaoca, za ispravku i ponovno slanje."

#: deliveries/api.py:267
msgid "Delivery not found."
msgstr "Dostava nije pronađena."

#: deliveries/api.py:273
msgid "Delivery not found (or belongs to another shop)."
msgstr "Dostava nije pronađena (ili pripada drugoj prodavnici)."

#: deliveries/api.py:281
msgid ""
"destination_not_allowed: new stores can message only Serbian mobile numbers "
"until verified."
msgstr ""
"destination_not_allowed: nove prodavnice mogu da šalju poruke samo na srpske "
"mobilne brojeve dok ne budu verifikovane."

#: deliveries/api.py:287
msgid ""
"Sending limit reached: daily_limit, monthly_limit, recipient_daily_limit or "
"resend_limit."
msgstr ""
"Dostignut je limit slanja: daily_limit, monthly_limit, recipient_daily_limit "
"ili resend_limit."

#: deliveries/api.py:291
msgid "global_limit: sending is paused for today."
msgstr "global_limit: slanje je pauzirano za danas."

#: deliveries/api.py:303
msgid "List deliveries"
msgstr "Lista dostava"

#: deliveries/api.py:308
msgid ""
"Filter by industry-standard status: pending, ready_for_pickup, "
"out_for_delivery, delivered."
msgstr ""
"Filter po standardnom statusu: pending, ready_for_pickup, out_for_delivery, "
"delivered."

#: deliveries/api.py:317
msgid ""
"Sort order. Default `created_at` (oldest first); use `-created_at` for newest"
" first."
msgstr ""
"Redosled. Podrazumevano `created_at` (najstarije prvo); `-created_at` za "
"najnovije prvo."

#: deliveries/api.py:326
msgid ""
"Set `true` to list soft-deleted deliveries (restore them via /restore). "
"Default lists only active ones."
msgstr ""
"Postavite `true` za listu obrisanih dostava (vraćaju se preko /restore). "
"Podrazumevano su prikazane samo aktivne."

#: deliveries/api.py:351 deliveries/templates/deliveries/api_docs.html:32
msgid "Create a delivery"
msgstr "Kreiranje dostave"

#: deliveries/api.py:353
msgid ""
"Creates a delivery (the address is geocoded server-side). Pass an "
"`Idempotency-Key` header to safely retry — the same key returns the same "
"delivery instead of creating a duplicate."
msgstr ""
"Kreira dostavu (adresa se geokodira na serveru). Pošaljite zaglavlje "
"`Idempotency-Key` da biste bezbedno ponovili zahtev — isti ključ vraća istu "
"dostavu umesto duplikata."

#: deliveries/api.py:362
msgid "Unique key to make creation idempotent (per shop)."
msgstr "Jedinstveni ključ koji kreiranje čini idempotentnim (po prodavnici)."

#: deliveries/api.py:368
msgid "Invalid phone or malformed JSON."
msgstr "Neispravan telefon ili neispravan JSON."

#: deliveries/api.py:369
msgid "Missing required fields."
msgstr "Nedostaju obavezna polja."

#: deliveries/api.py:393 deliveries/api.py:424
#, python-format
msgid "Missing required fields: %(fields)s."
msgstr "Nedostaju obavezna polja: %(fields)s."

#: deliveries/api.py:411
msgid "language must be one of: sr, en."
msgstr "language mora biti jedno od: sr, en."

#: deliveries/api.py:431 deliveries/api.py:664
msgid "Invalid recipient phone number."
msgstr "Neispravan broj telefona primaoca."

#: deliveries/api.py:479
msgid "Get a delivery"
msgstr "Preuzimanje dostave"

#: deliveries/api.py:488
msgid "Delete a delivery (soft)"
msgstr "Brisanje dostave (može da se vrati)"

#: deliveries/api.py:489
msgid "Soft-deletes the delivery; it can be restored via /restore."
msgstr "Briše dostavu tako da može da se vrati preko /restore."

#: deliveries/api.py:503
msgid "Start delivery (dispatch)"
msgstr "Početak dostave (polazak)"

#: deliveries/api.py:505
msgid ""
"Marks the delivery 'out for delivery': computes ETA, notifies the customer "
"with a tracking link. If no route is available, pass `eta` (HH:MM)."
msgstr ""
"Označava dostavu kao „u dostavi“: računa vreme dolaska i obaveštava kupca sa "
"linkom za praćenje. Ako ruta nije dostupna, pošaljite `eta` (HH:MM)."

#: deliveries/api.py:511
msgid "Invalid or past eta."
msgstr "Neispravan ili već prošao eta."

#: deliveries/api.py:513
msgid "Route unavailable — pass eta (HH:MM)."
msgstr "Ruta nije dostupna — pošaljite eta (HH:MM)."

#: deliveries/api.py:530
msgid "Route is unavailable — pass eta (HH:MM) to start the delivery."
msgstr "Ruta nije dostupna — pošaljite eta (HH:MM) da biste započeli dostavu."

#: deliveries/api.py:558
msgid "eta must be HH:MM or an ISO 8601 datetime."
msgstr "eta mora biti u formatu HH:MM ili ISO 8601 datum i vreme."

#: deliveries/api.py:563
msgid "eta must be in the future."
msgstr "eta mora biti u budućnosti."

#: deliveries/api.py:572
msgid "Dispatch (alias of start)"
msgstr "Polazak (isto što i start)"

#: deliveries/api.py:573
msgid "Identical to POST /start; provided for naming parity with the UI."
msgstr "Isto što i POST /start; postoji radi istog naziva kao u aplikaciji."

#: deliveries/api.py:586
msgid "Mark ready for pickup"
msgstr "Označavanje kao spremno za preuzimanje"

#: deliveries/api.py:587
msgid "Transitions a 'pending' delivery to 'ready_for_pickup' (new → ready)."
msgstr "Prebacuje dostavu iz „pending“ u „ready_for_pickup“ (nova → spremna)."

#: deliveries/api.py:602 deliveries/templates/deliveries/_delivery_card.html:61
msgid "Mark delivered"
msgstr "Označi isporučeno"

#: deliveries/api.py:603
msgid "Marks the delivery as delivered (optional manual confirmation)."
msgstr "Označava dostavu kao isporučenu (opciona ručna potvrda)."

#: deliveries/api.py:618
msgid "Restore a soft-deleted delivery"
msgstr "Vraćanje obrisane dostave"

#: deliveries/api.py:633
msgid "Resend the 'on the way' notification"
msgstr "Ponovno slanje obaveštenja „u dostavi“"

#: deliveries/api.py:635
msgid ""
"Re-sends the 'on the way' notification (optionally to a corrected phone). "
"Only valid after the delivery has started."
msgstr ""
"Ponovo šalje obaveštenje „u dostavi“ (po potrebi na ispravljen broj). Moguće "
"je tek kada dostava počne."

#: deliveries/api.py:648 deliveries/api.py:674
msgid "Delivery has not started — nothing to resend."
msgstr "Dostava nije počela — nema šta ponovo da se pošalje."

#: deliveries/api.py:701
msgid "Store name (shown to customers; no links or phone numbers)."
msgstr "Naziv prodavnice (vide ga kupci; bez linkova i brojeva telefona)."

#: deliveries/api.py:705
msgid "Store address; geocoded server-side into the ETA origin."
msgstr ""
"Adresa prodavnice; geokodira se na serveru kao polazna tačka za vreme "
"dolaska."

#: deliveries/api.py:710
msgid "Merchant https URL that receives signed event webhooks."
msgstr "https URL prodavnice na koji stižu potpisani vebhuk događaji."

#: deliveries/api.py:714
msgid "Secret for the Javi-Signature HMAC of webhook bodies (write-only)."
msgstr "Tajna za Javi-Signature HMAC potpis vebhuk poruka (samo upis)."

#: deliveries/auth.py:56
msgid "Missing or invalid API key."
msgstr "API ključ nedostaje ili nije ispravan."

#: deliveries/context_processors.py:33
msgid "Today"
msgstr "Danas"

#: deliveries/context_processors.py:34
msgid "This month"
msgstr "Ovaj mesec"

#: deliveries/forms.py:13 deliveries/views.py:430
msgid "Invalid number. E.g. 064 123 4567"
msgstr "Neispravan broj. Npr. 064 123 4567"

#: deliveries/forms.py:28
msgid "Store address"
msgstr "Adresa prodavnice"

#: deliveries/forms.py:38
msgid "Phone for customers (optional)"
msgstr "Telefon za kupce (opciono)"

#: deliveries/forms.py:44
msgid "Webhook URL"
msgstr "URL vebhuka"

#: deliveries/forms.py:53
msgid "Webhook secret"
msgstr "Tajna vebhuka"

#: deliveries/forms.py:59
msgid "Remove the secret"
msgstr "Ukloni tajnu"

#: deliveries/forms.py:80 deliveries/forms.py:176
msgid "Phone"
msgstr "Telefon"

#: deliveries/forms.py:86
msgid "Name"
msgstr "Ime"

#: deliveries/forms.py:89
msgid "Customer's language"
msgstr "Jezik kupca"

#: deliveries/forms.py:95
msgid "Address"
msgstr "Adresa"

#: deliveries/forms.py:98
msgid "Street and number, city"
msgstr "Ulica i broj, grad"

#: deliveries/forms.py:101
msgid "Description (optional)"
msgstr "Opis (opciono)"

#: deliveries/forms.py:124 deliveries/forms.py:195
msgid "Arrival date"
msgstr "Datum dolaska"

#: deliveries/forms.py:129 deliveries/forms.py:200
msgid "Arrival time (HH:MM)"
msgstr "Vreme dolaska (HH:MM)"

#: deliveries/forms.py:166 deliveries/forms.py:216
msgid "This time has already passed. Enter a time in the future."
msgstr "To vreme je već prošlo. Unesite vreme u budućnosti."

