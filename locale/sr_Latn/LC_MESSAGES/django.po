msgstr ""
"Adresa prodavnice nije geokodirana — otvorite „Prodavnica“ i sačuvajte "
"adresu."

#: deliveries/services.py:206
msgid ""
"We could not recognize the delivery address — check the recipient address."
msgstr "Nismo prepoznali adresu dostave — proverite adresu primaoca."

#: deliveries/services.py:207
msgid "The map can't compute a route right now — enter the time manually."
msgstr "Mapa trenutno ne može da izračuna rutu — unesite vreme ručno."

#: deliveries/services.py:271
#, python-format
msgid ""
"Your order from \"%(shop)s\" is on its way. Arriving approximately by "
"%(time)s. Track: %(link)s"
msgstr ""
"Vaša porudžbina iz \"%(shop)s\" je u dostavi. Stiže okvirno do %(time)s. "
"Pratite: %(link)s"

#: deliveries/services.py:282
#, python-format
msgid "How did the delivery from \"%(shop)s\" go? Rate it: %(link)s"
msgstr "Kako je prošla dostava iz \"%(shop)s\"? Ocenite: %(link)s"

